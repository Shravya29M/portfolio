{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "security:openssf-scorecard",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/New_York",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group all GitHub Actions bumps into one PR and automerge them.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge non-major dev/test tooling once CI is green.",
      "matchDepTypes": [
        "devDependencies",
        "dev",
        "test"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Patch bumps of runtime deps are low risk; group them.",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch dependencies"
    },
    {
      "description": "Major bumps always get a standalone PR and a human review.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Let a release sit briefly before proposing it, to dodge yanked versions.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "React and its renderer must move together or the build breaks.",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "Build toolchain \u2014 group so vite and its plugins stay compatible.",
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "vitest",
        "@vitest/coverage-v8",
        "jsdom",
        "eslint",
        "@eslint/js",
        "globals",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh"
      ],
      "groupName": "build tooling"
    },
    {
      "description": "Tailwind v4 moved its PostCSS plugin out of core \u2014 keep them in lockstep.",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/postcss",
        "postcss",
        "autoprefixer"
      ],
      "groupName": "tailwind"
    }
  ]
}
